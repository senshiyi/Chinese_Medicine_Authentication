# =============================================================
# 骨碎补在线真伪鉴定 V2 — 阶段 A 环境变量示例
# 复制为 .env 后按实际环境修改；本文件不包含任何真实密钥。
# =============================================================

# 运行环境: dev | test | prod（prod 开启 Secure Cookie 等）
DRYNARIA_ENVIRONMENT=dev

# ---- 数据库（PostgreSQL，Compose 内使用）----
DATABASE_URL=postgresql+psycopg://drynaria:drynaria@localhost:5432/drynaria_stage_a

# ---- Redis / Celery ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ---- 对象存储（MinIO/S3；留空且 STORAGE_BACKEND=auto 时使用本地磁盘存储）----
STORAGE_BACKEND=auto            # auto | local | s3
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=drynaria-stage-a
S3_ACCESS_KEY=drynaria-minio
S3_SECRET_KEY=change-me-minio-secret
# auto 模式且 S3_ENDPOINT_URL 为空时，图片落到本地目录（本地开发）
STORAGE_LOCAL_DIR=var/local-storage

# ---- 推理 Worker（模型只读；仅 Worker 挂载，API 不加载模型）----
# 只读引用原闭集实验项目，不要复制训练包或权重到本仓库
INFERENCE_PROJECT_PATH=../项目/Files
MODEL_CHECKPOINT_PATH=../项目/Models/best_multitask_model.calibrated.pth
# 与 checkpoint metadata.model_version 保持一致，用于 analyze 幂等键
MODEL_VERSION_HINT=closed-set-v1
STRATEGY_VERSION=stage-a-strategy-v1
# 闭集二分类天然总有一个 argmax；该下限为 0.0 时不启用“无法判断”门槛（阶段 C 校准后调整）
CLOSED_SET_MIN_CONFIDENCE=0.0
# Worker 领取 job 后超过该秒数未完成视为进程崩溃，可被其它 Worker 原子重领
WORKER_CLAIM_TIMEOUT_SECONDS=3600

# ---- 范围（scope）门控 ----
# 默认启用：只有 scope=accepted 的图片才给出公开真伪结论；rejected/unavailable 一律 inconclusive。
SCOPE_ENFORCEMENT=true
# 范围分类工件（JSON artifact）。为空时默认为 unavailable 门控（不会把实验闭集预测当有效结论呈现）。
SCOPE_ARTIFACT_PATH=

# ---- 上传策略 ----
UPLOAD_MAX_BYTES=20971520        # 20 MB 压缩后字节上限
UPLOAD_MAX_PIXELS=40000000       # 4000 万解码像素上限
IMAGE_RETENTION_DAYS=30          # 未授权研究原图在任务完成后保留天数

# ---- 会话 / CORS / CSRF ----
SESSION_TTL_DAYS=14
COOKIE_SECURE=false              # prod 环境强制为 true
# 多个来源用逗号分隔
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 其它 ----
AUTO_CREATE_TABLES=false         # 仅本地无 alembic 时使用；生产用 alembic upgrade
